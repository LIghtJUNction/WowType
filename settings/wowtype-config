def gnome_shell_settings():
    """GNOME Shell 的 gsettings（不是 GNOME 返回 None）。"""
    if "GNOME" not in os.environ.get("XDG_CURRENT_DESKTOP", "").upper():
        return None
    source = Gio.SettingsSchemaSource.get_default()
    if source is None or source.lookup("org.gnome.shell", True) is None:
        return None
    return Gio.Settings.new("org.gnome.shell")


def gnome_extension_info(uuid):
    """GNOME Shell 里这个扩展的信息；这次登录没扫到（新装的扩展要重新登录）时是空字典。

    注意接口在 org.gnome.Shell 上；org.gnome.Shell.Extensions 那个名字是「扩展」应用，
    不自动启动时根本不存在。
    """
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        value = bus.call_sync("org.gnome.Shell", "/org/gnome/Shell",
                              "org.gnome.Shell.Extensions", "GetExtensionInfo",
                              GLib.Variant("(s)", (uuid,)), GLib.VariantType("(a{sv})"),
                              Gio.DBusCallFlags.NO_AUTO_START, 2000, None)
        return value.unpack()[0]
    except GLib.Error:
        return {}


def gnome_extension_loaded(uuid):
    """GNOME Shell 这次登录有没有扫到这个扩展。"""
    return bool(gnome_extension_info(uuid))


def set_gnome_extension(settings, uuid, enabled):
    """在 enabled-extensions 里加上/去掉；GNOME Shell 盯着这个键，扫到了的扩展马上生效。"""
    on = [u for u in settings.get_strv("enabled-extensions") if u != uuid]
    off = [u for u in settings.get_strv("disabled-extensions") if u != uuid]
    (on if enabled else off).append(uuid)
    settings.set_strv("enabled-extensions", on)
    settings.set_strv("disabled-extensions", off)


def fcitx_call_sync(method, params=None, reply=None):
    """同步调 fcitx5（命令行和后台任务用）；fcitx5 没在跑时返回 None。"""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        return bus.call_sync(Fcitx.NAME, Fcitx.PATH, Fcitx.IFACE, method, params,
                             GLib.VariantType(reply) if reply else None,
                             Gio.DBusCallFlags.NO_AUTO_START, 3000, None)
    except GLib.Error:
        return None



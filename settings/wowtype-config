# ---------------------------------------------------------------- 文件读写


def read_config():
    """读 wowtype.conf，返回 (值, 原文里不认识的行)。"""
    values = dict(DEFAULTS)
    extra = []
    try:
        with open(CONFIG_FILE, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return values, extra
    for line in lines:
        key, sep, value = line.partition("=")
        key = key.strip()
        if sep and key in DEFAULTS:
            values[key] = value.strip().strip('"')
        elif line.strip():
            extra.append(line)
    return values, extra


def write_atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def write_config(values, extra):
    lines = [f"{key}={values[key]}" for key in DEFAULTS]
    write_atomic(CONFIG_FILE, "\n".join(lines + extra) + "\n")


def log(message):
    """往共用日志里记一行（和插件同一个文件，标成 settings）。写不了就算了。"""
    if LOG_FILE == "0":
        return
    try:
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        now = time.time()
        stamp = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(now))
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"{stamp}.{int(now * 1000) % 1000:03d} I settings {message}\n")
    except OSError:
        pass


def read_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def update_state(**changes):
    state = read_state()
    state.update(changes)
    try:
        write_atomic(STATE_FILE, json.dumps(state, ensure_ascii=False))
    except OSError:
        pass


def read_custom_words():
    words = []
    try:
        with open(CUSTOM_FILE, encoding="utf-8") as f:
            for line in f:
                line = line.rstrip("\r\n")
                if not line.strip() or line.startswith("#"):
                    continue
                cols = line.split("\t")
                if len(cols) >= 2 and cols[1].strip():
                    words.append((cols[0].strip(), cols[1].strip()))
    except OSError:
        pass
    return words


def write_custom_words(words):
    out = ["# WowType 自定义词：拼音<TAB>词。由 WowType 设置维护，也可以手动编辑。"]
    out += [f"{pinyin}\t{word}" for pinyin, word in words]
    write_atomic(CUSTOM_FILE, "\n".join(out) + "\n")


# ---------------------------------------------------------------- 拼音


def split_syllables(text):
    """nihao -> ['ni', 'hao']：音节数最少，一样多时前面的取长的。切不开返回 None。"""
    n = len(text)
    best = [None] * (n + 1)
    best[n] = (0, 0)
    for i in range(n - 1, -1, -1):
        for length in range(min(6, n - i), 0, -1):
            if text[i:i + length] in SYLLABLES and best[i + length] is not None:
                count = best[i + length][0] + 1
                if best[i] is None or count < best[i][0]:
                    best[i] = (count, length)
    if best[0] is None:
        return None
    parts, i = [], 0
    while i < n:
        length = best[i][1]
        parts.append(text[i:i + length])
        i += length
    return parts


def normalize_pinyin(text):
    """把用户打的拼音整理成空格分隔的音节：Ni Hǎo / nihao / ni'hao -> ni hao。不合法返回 None。"""
    text = unicodedata.normalize("NFD", text.strip().lower())
    text = text.replace("u\u0308", "v").replace("u:", "v")
    # 去掉声调符号和数字声调
    text = "".join(c for c in text if not unicodedata.combining(c))
    text = "".join(c for c in text if not c.isdigit())
    syllables = []
    for token in text.replace("'", " ").replace("’", " ").split():
        if token in SYLLABLES:
            syllables.append(token)
        elif token == "r" and syllables:
            syllables.append(token)  # 儿化
        else:
            parts = split_syllables(token)
            if parts is None:
                return None
            syllables += parts
    return " ".join(syllables) if syllables else None


class PinyinGuesser:
    """在词库里查词的拼音（后台载入，查词时在内存里找，几十毫秒）。"""

    def __init__(self):
        self.data = None
        threading.Thread(target=self._load, daemon=True).start()

    def _load(self):
        for path in LEXICON_CANDIDATES:
            if path and os.path.exists(path):
                try:
                    with open(path, "rb") as f:
                        self.data = f.read()
                    return
                except OSError:
                    continue

    def _lookup(self, word):
        data = self.data
        needle = b"\t" + word.encode("utf-8") + b"\t"
        best, best_freq = None, -1.0
        pos = data.find(needle)
        while pos >= 0:
            start = data.rfind(b"\n", 0, pos) + 1
            end = data.find(b"\n", pos)
            end = len(data) if end < 0 else end
            freq_text = data[pos + len(needle):end].strip()
            try:
                freq = float(freq_text)
            except ValueError:
                freq = 0.0
            if freq > best_freq:
                best, best_freq = data[start:pos].decode("utf-8", "replace"), freq
            pos = data.find(needle, end)
        return best

    def guess(self, word):
        """返回拼音，猜不出（有生僻字、英文、词库还没载入）返回 None。"""
        if not self.data or not word:
            return None
        found = self._lookup(word)
        if found:
            return normalize_pinyin(found)
        readings = []
        for char in word:
            reading = self._lookup(char)
            if not reading:
                return None
            readings.append(reading)
        return normalize_pinyin(" ".join(readings))



    if "--self-test" in sys.argv:
        assert normalize_pinyin("Ni Hǎo") == "ni hao"
        assert normalize_pinyin("nihao") == "ni hao"
        assert normalize_pinyin("xi'an") == "xi an"
        assert normalize_pinyin("lǜ") == "lv"
        assert normalize_pinyin("hua r") == "hua r"
        assert normalize_pinyin("github") is None
        assert len(SYLLABLES) == 432
        assert parse_version("v0.2.10") > parse_version("0.2.9")
        assert parse_version("0.2.1-1~ubuntu26.04") == (0, 2, 1)
        assert parse_version("2026.10.31") < parse_version("2026.11.01")
        notes = markdown_to_pango("## 标题\n\n- **粗** `a<b>` [链接](https://x.y/?a=1&b=2)\n  - 子项\n"
                                  "```bash\nsudo apt <x>\n```\nhttps://x.y/z")
        assert notes.startswith('<span lang="zh-cn">') and notes.endswith("</span>")
        assert '<span size="large" weight="bold">标题</span>' in notes
        assert "• <b>粗</b> <tt>a&lt;b&gt;</tt>" in notes
        assert '<a href="https://x.y/?a=1&amp;b=2">链接</a>' in notes
        assert "    ◦ 子项" in notes and "<tt>sudo apt &lt;x&gt;</tt>" in notes
        assert "```" not in notes and '<a href="https://x.y/z">' in notes
        import tempfile
        with tempfile.TemporaryDirectory() as tmp:
            profile = os.path.join(tmp, "profile")
            assert "新建" in profile_add_wowtype(profile)
            assert "已经在" in profile_add_wowtype(profile)
            with open(profile, "w", encoding="utf-8") as f:
                f.write("[Groups/0]\n# Group Name\nName=Default\nDefault Layout=us\nDefaultIM=rime\n\n"
                        "[Groups/0/Items/0]\nName=keyboard-us\nLayout=\n\n"
                        "[Groups/0/Items/1]\nName=rime\nLayout=\n\n[GroupOrder]\n0=Default\n")
            assert "已把" in profile_add_wowtype(profile)
            with open(profile, encoding="utf-8") as f:
                assert f.read().endswith("[Groups/0/Items/2]\nName=wowtype\nLayout=\n")
            assert "已经在" in profile_add_wowtype(profile)
            assert os.path.exists(profile + ".bak-wowtype")
        print("self-test ok")
        sys.exit(0)
    sys.exit(SettingsApp().run(sys.argv))

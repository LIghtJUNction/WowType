def _home(text):
    home = os.path.expanduser("~")
    return text.replace(home, "~") if home and home != "/" else text


def _run(cmd, timeout=10):
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return (out.stdout + out.stderr).strip()
    except (OSError, subprocess.SubprocessError) as e:
        return f"（{cmd[0]} 运行失败：{e}）"


def _tail(path, lines):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().splitlines()[-lines:]
    except OSError:
        return []


def _file_line(path):
    if not path:
        return None
    try:
        st = os.stat(path)
    except OSError:
        return f"  {path}：没有"
    if os.path.isdir(path):
        size = dir_size(path)
    else:
        size = st.st_size
    stamp = time.strftime("%Y-%m-%d %H:%M", time.localtime(st.st_mtime))
    return f"  {path}：{size / 1e6:.1f} MB，{stamp}"


def _count_lines(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return sum(1 for line in f if line.strip() and not line.startswith("#"))
    except OSError:
        return None


def collect_diagnostics():
    """导出给开发者看的诊断信息（纯文本）。

    不含打过的字、自定义词和输入习惯的内容（只有条数），家目录写成 ~。
    """
    out = []
    add = out.append
    add("# WowType 诊断信息")
    add(f"导出时间：{time.strftime('%Y-%m-%d %H:%M:%S %z')}")
    add("不含你打过的字、自定义词和输入习惯的内容（只有条数和大小）。")
    add("")
    add("## 版本")
    add(f"设置界面：{current_version()}")
    manager, _distro, _arch, _reason = update_platform()
    add(f"{ENGINE_PKG}：{package_version(manager) or '源码或系统配置管理的安装'}")
    if dpkg_version(DATA_PKG):  # 0.3.3 及以前词库是单独的包
        add(f"{DATA_PKG}：{dpkg_version(DATA_PKG)}")
    try:
        with open(DATA_VERSION_FILE, encoding="utf-8") as f:
            add(f"安装包里的词库：{f.read().strip()}")
    except OSError:
        pass
    add(f"fcitx5：{_run(['fcitx5', '--version'])}")
    os_name = ""
    try:
        with open("/etc/os-release", encoding="utf-8") as f:
            for line in f:
                if line.startswith("PRETTY_NAME="):
                    os_name = line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    add(f"系统：{os_name}，内核 {os.uname().release}，{os.uname().machine}")
    for key in ("XDG_CURRENT_DESKTOP", "XDG_SESSION_TYPE", "LANG", "GTK_IM_MODULE",
                "QT_IM_MODULE", "XMODIFIERS"):
        add(f"{key}={os.environ.get(key, '')}")
    add("")

    add("## fcitx5")
    group = fcitx_call_sync("CurrentInputMethodGroup", None, "(s)")
    if group is None:
        add("fcitx5 没在运行（或连不上 D-Bus）")
    else:
        name = group.unpack()[0]
        info = fcitx_call_sync("InputMethodGroupInfo", GLib.Variant("(s)", (name,)), "(sa(ss))")
        items = [im for im, _layout in info.unpack()[1]] if info else []
        add(f"输入法组 {name}：{', '.join(items)}")
        current = fcitx_call_sync("CurrentInputMethod", None, "(s)")
        if current is not None:
            add(f"当前输入法：{current.unpack()[0]}")
        theme = fcitx_call_sync("GetConfig", GLib.Variant("(s)", (CLASSICUI_URI,)),
                                "(va(sa(sssva{sv})))")
        if theme is not None:
            cfg = theme.unpack()[0]
            add(f"经典界面主题：{cfg.get('Theme')} / {cfg.get('DarkTheme')}，"
                f"跟随深色 {cfg.get('UseDarkTheme')}")
    shell = gnome_shell_settings()
    if shell is not None:
        enabled = shell.get_strv("enabled-extensions")
        states = {1: "在运行", 2: "已停用", 3: "出错", 4: "版本不兼容"}
        for uuid in (KIMPANEL_EXT, GNOME_THEME_EXT):
            info = gnome_extension_info(uuid)
            state = states.get(int(info.get("state", 0)), f"状态 {info.get('state')}") \
                if info else "这次登录没加载"
            error = f"，错误：{info['error']}" if info.get("error") else ""
            add(f"GNOME 扩展 {uuid}：{'已启用' if uuid in enabled else '没启用'}，{state}{error}")
    add("")

    add("## WowType 设置（wowtype.conf）")
    values, _extra = read_config()
    add(", ".join(f"{k}={v}" for k, v in values.items()))
    add("")

    add("## 数据文件")
    for path in [*LEXICON_CANDIDATES,
                 os.path.join(DATA_DIR, "english.txt"), "/usr/share/wowtype/english.txt",
                 os.environ.get("WOWTYPE_LM", ""),
                 os.path.join(DATA_DIR, "words.lm"), "/usr/share/wowtype/words.lm",
                 os.path.join(DATA_DIR, "lexicon.tsv.wcache"),
                 os.path.join(DATA_DIR, "wetype", "nlrgpt2_nnlm.bin"),
                 VOICE_MODEL_DIR]:
        line = _file_line(path)
        if line:
            add(line)
    for label, path in (("自定义词", CUSTOM_FILE),
                        ("自动学到的词", os.path.join(DATA_DIR, "user.tsv")),
                        ("输入习惯", os.path.join(DATA_DIR, "history.tsv"))):
        count = _count_lines(path)
        add(f"  {label}：{'没有' if count is None else f'{count} 条'}")
    add("")

    add("## WowType 日志（最近 400 行）")
    lines = _tail(LOG_FILE + ".1", 400) + _tail(LOG_FILE, 400)
    out.extend(lines[-400:] or ["（还没有日志：要用新版的 WowType 打过一次字才会有）"])
    add("")

    add("## fcitx5 日志（这次开机，最近 300 行）")
    add(_run(["journalctl", "--user", "-b", "--no-pager", "-o", "short-iso", "-n", "300",
              "_COMM=fcitx5"], timeout=20) or "（没有）")
    return _home("\n".join(out)) + "\n"


